{#
  Milestone 14 — ficha de Perspectiva (artículo), bilingüe ES/EN.
  Mismo criterio que propiedad.njk/proyecto.njk. "contenido"/"contenidoEn"
  usan el mismo filtro "descripcionHtml" que Propiedades — el mismo
  subconjunto de Markdown (bold/italic/listas) que el CMS ya sabe
  producir, sin reinventar nada.
#}
{% set lang = lang or "es" %}
{% set esEn = lang == "en" %}
{% set tituloMostrado = (perspectiva.tituloEn or perspectiva.titulo) if esEn else perspectiva.titulo %}
{% set contenidoMostrado = (perspectiva.contenidoEn or perspectiva.contenido) if esEn else perspectiva.contenido %}
{% set extractoMostrado = (perspectiva.extractoEn or perspectiva.extracto) if esEn else perspectiva.extracto %}
{% set urlBase = "https://makomgrp.com/en/insights/" if esEn else "https://makomgrp.com/perspectivas/" %}
{% set urlCanonica = urlBase + perspectiva.slug + "/" %}
{% set urlAlternoEs = "https://makomgrp.com/perspectivas/" + perspectiva.slug + "/" %}
{% set urlAlternoEn = "https://makomgrp.com/en/insights/" + perspectiva.slug + "/" %}
{% set langSwitchUrl = urlAlternoEs if esEn else urlAlternoEn %}
{% set esIndexablePerspectiva = perspectiva | esIndexable %}
{#
  SEO Block 4E — misma arquitectura que _includes/propiedad.njk y
  _includes/proyecto.njk ("Alternativa A"): fallback automático
  únicamente "tituloMostrado + | MAKOM", sin truncado rígido. Override
  manual ("seo.titulo"/"seo.tituloEn") se usa tal cual, sin truncar, y
  sin fallback cruzado entre idiomas — una ficha EN sin "seo.tituloEn"
  nunca cae al "seo.titulo" en español (el mismo bug que causó el
  artículo de Turismo roto en el Block 1).
#}
{% set tituloSeo = (perspectiva.seo.titulo if not esEn else perspectiva.seo.tituloEn) or (tituloMostrado + " | MAKOM") %}
{% set descripcionSeoBase = (perspectiva.seo.descripcion if not esEn else (perspectiva.seo.descripcionEn or perspectiva.seo.descripcion)) %}
{% set descripcionSeo = descripcionSeoBase or (extractoMostrado | resumenSeo(155)) %}
{% set imagenAbsoluta = ("https://makomgrp.com" + perspectiva.imagenPortada) if perspectiva.imagenPortada else null %}
{% set imagenOgUrl = imagenAbsoluta or "https://makomgrp.com/assets/og/makom-capital-group-og.jpg" %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ descripcionSeo }}" />
  <meta name="theme-color" content="#0A0A0A" />
  <meta name="robots" content="{{ 'index, follow' if esIndexablePerspectiva else 'noindex, follow' }}" />
  <link rel="canonical" href="{{ urlCanonica }}" />
  <link rel="alternate" hreflang="es" href="{{ urlAlternoEs }}" />
  <link rel="alternate" hreflang="en" href="{{ urlAlternoEn }}" />
  <link rel="alternate" hreflang="x-default" href="{{ urlAlternoEs }}" />
  <link rel="icon" type="image/svg+xml" href="/MAKOM_Logo_Files_v4.0/04_Favicon/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/MAKOM_Logo_Files_v4.0/04_Favicon/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/MAKOM_Logo_Files_v4.0/04_Favicon/favicon-16.png" />
  <link rel="apple-touch-icon" href="/MAKOM_Logo_Files_v4.0/04_Favicon/apple-touch-icon.png" />
  <title>{{ tituloSeo }}</title>
  <meta property="og:title" content="{{ tituloSeo }}" />
  <meta property="og:description" content="{{ descripcionSeo }}" />
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="{{ 'en_US' if esEn else 'es_PA' }}" />
  <meta property="og:url" content="{{ urlCanonica }}" />
  <meta property="og:image" content="{{ imagenOgUrl }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ tituloSeo }}" />
  <meta name="twitter:description" content="{{ descripcionSeo }}" />
  <meta name="twitter:image" content="{{ imagenOgUrl }}" />
  <link rel="stylesheet" href="/styles.css" />
  {% if esIndexablePerspectiva %}
  <script type="application/ld+json">{{ perspectiva | jsonLdArticulo(urlCanonica, imagenAbsoluta, lang, tituloMostrado, extractoMostrado) | dump | safe }}</script>
  {% endif %}
  {% include "meta-pixel.njk" %}
</head>
<body class="pagina-interior">

{% include "header.njk" %}

<main id="main" role="main">
  {#
    MAKOM Editorial Signature — presentación del artículo. Cabecera asimétrica (titular a la izquierda, datos a la
    derecha), portada protagonista sin recortes, columna de lectura con la tarjeta de contacto en el margen y,
    al final, "Continuar explorando" con hasta tres artículos reales del CMS. Funciona igual con cualquier
    artículo, también los que se creen desde Decap: no depende de la longitud del texto ni del formato de la portada.
  #}
  {% set relacionadas = collections.perspectivas | perspectivasRelacionadas(perspectiva, 3) %}
  <article class="articulo" aria-labelledby="ficha-titulo">

    <header class="articulo__cabecera">
      <div class="container">
        <nav class="articulo__migas" aria-label="{{ 'Breadcrumb' if esEn else 'Ruta de navegación' }}">
          <a href="{{ '/en/insights/' if esEn else '/perspectivas/' }}">{{ "Insights" if esEn else "Perspectivas" }}</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{{ tituloMostrado }}</span>
        </nav>

        <div class="articulo__titular" data-reveal>
          <div class="articulo__titular-texto">
            {% if perspectiva.categoria %}<p class="articulo__categoria"><span class="article-card__category">{{ perspectiva.categoria | categoriaPerspectiva(lang, categoriasPerspectivas) }}</span></p>{% endif %}
            <h1 class="articulo__titulo" id="ficha-titulo">{{ tituloMostrado }}</h1>
          </div>
          {% if perspectiva.fecha or perspectiva.autor %}
          <p class="articulo__datos">
            {%- if perspectiva.fecha %}<time class="articulo__fecha" datetime="{{ perspectiva.fecha }}">{{ perspectiva.fecha | fechaFormato(lang) }}</time>{% endif -%}
            {%- if perspectiva.fecha and perspectiva.autor %}<span class="articulo__datos-sep" aria-hidden="true"> · </span>{% endif -%}
            {%- if perspectiva.autor %}<span class="articulo__autor">{{ perspectiva.autor }}</span>{% endif -%}
          </p>
          {% endif %}
        </div>
      </div>
    </header>

    {% if perspectiva.imagenPortada %}
    <div class="container">
      <figure class="articulo__portada" data-reveal>
        <div class="articulo__portada-marco">
          <img src="{{ perspectiva.imagenPortada }}" alt="{{ tituloMostrado }}" eleventy:widths="800,1200,1800" sizes="(min-width: 1280px) 1160px, (min-width: 768px) calc(100vw - 80px), calc(100vw - 48px)" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </figure>
    </div>
    {% endif %}

    <div class="container articulo__cuerpo">
      <div class="articulo__texto" data-reveal>
        {% if contenidoMostrado %}{{ contenidoMostrado | articuloHtml | safe }}{% endif %}
      </div>

      <aside class="articulo__lateral">
        <div class="articulo__contacto" data-reveal>
          <p class="articulo__contacto-lema">{{ "Where every space has a purpose." if esEn else "Donde cada espacio tiene propósito." }}</p>
          <a class="btn btn--outline articulo__contacto-btn" href="{{ '/en/#contacto' if esEn else '/#contacto' }}">{{ "Contact us" if esEn else "Contáctenos" }}</a>
        </div>
      </aside>
    </div>
  </article>

  {% if relacionadas.length > 0 %}
  <section class="articulo-explorar" aria-labelledby="explorar-titulo">
    <div class="container">
      <div class="articulo-explorar__cabecera" data-reveal>
        <h2 class="articulo-explorar__titulo" id="explorar-titulo">{{ "Keep exploring" if esEn else "Continuar explorando" }}</h2>
        <a class="link--arrow ficha-relacionadas__vertodas articulo-explorar__todas" href="{{ '/en/insights/' if esEn else '/perspectivas/' }}">{{ "View all insights" if esEn else "Ver todas las perspectivas" }}</a>
      </div>
      <div class="articulo-explorar__grid" role="group" aria-label="{{ 'Related insights' if esEn else 'Perspectivas relacionadas' }}">
        {% for a in relacionadas %}
        {% set tituloA = (a.tituloEn or a.titulo) if esEn else a.titulo %}
        {% set extractoA = (a.extractoEn or a.extracto) if esEn else a.extracto %}
        <article class="article-card articulo-explorar__card" aria-labelledby="rel-{{ a.slug }}-title" data-reveal>
          <div class="article-card__meta">
            {% if a.categoria %}<span class="article-card__category">{{ a.categoria | categoriaPerspectiva(lang, categoriasPerspectivas) }}</span>{% endif %}
            {% if a.categoria and a.fecha %}<span class="article-card__sep">·</span>{% endif %}
            {% if a.fecha %}<span class="article-card__date">{{ a.fecha | fechaFormato(lang) }}</span>{% endif %}
          </div>
          <h3 class="article-card__title" id="rel-{{ a.slug }}-title">{{ tituloA }}</h3>
          {% if extractoA %}<p class="article-card__extract">{{ extractoA | extractoPlano }}</p>{% endif %}
          <a href="{{ ('/en/insights/' if esEn else '/perspectivas/') + a.slug + '/' }}" class="link--arrow article-card__cta">{{ "Read article" if esEn else "Ver artículo" }}</a>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
</main>

{% include "footer.njk" %}

</body>
</html>
