  <nav class="mobile-menu__nav" aria-label="Navegación móvil">
    <ul class="mobile-menu__list" role="list">
      <li class="mobile-menu__item" style="--item-index: 0"><a href="/#grupo" class="mobile-menu__link">El Grupo</a></li>
      <li class="mobile-menu__item" style="--item-index: 1"><a href="/#servicios" class="mobile-menu__link">Servicios</a></li>
      <li class="mobile-menu__item" style="--item-index: 2"><a href="/propiedades/" class="mobile-menu__link">Propiedades</a></li>
      <li class="mobile-menu__item" style="--item-index: 3"><a href="/#proyectos" class="mobile-menu__link">Proyectos</a></li>
      <li class="mobile-menu__item" style="--item-index: 4"><a href="/#contacto" class="mobile-menu__link">Contacto</a></li>
    </ul>
    <div class="mobile-menu__footer">
      <p class="mobile-menu__tagline">Donde cada espacio tiene propósito.</p>
    </div>
  </nav>
