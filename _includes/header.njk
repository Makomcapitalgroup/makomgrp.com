                  <span class="mega-menu__item-desc">Brokerage y asesoría de patrimonio</span>
                </a>
                <a href="/#servicios" class="mega-menu__item">
                  <span class="mega-menu__item-name">MAKOM Services</span>
                  <span class="mega-menu__item-desc">Gestión y mantenimiento de propiedades</span>
                </a>
                <a href="/#proyectos" class="mega-menu__item">
                  <span class="mega-menu__item-name">MAKOM Development</span>
                  <span class="mega-menu__item-desc">Transformación y desarrollo de espacios</span>
                </a>
                <a href="/#contacto" class="mega-menu__item mega-menu__item--coming">
