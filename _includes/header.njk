        <li class="header__nav-item"><a href="/#contacto" class="header__nav-link header__nav-link--cta">Contacto</a></li>
      </ul>
    </nav>
    <button class="hamburger" id="hamburger" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="mobile-menu">
