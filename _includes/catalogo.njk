{#
  Milestone 13 — bilingüe ES/EN. Cuerpo compartido del catálogo público
  de propiedades — usado por content/propiedades-catalogo.njk (ES,
  /propiedades/) y content/propiedades-catalogo-en.njk (EN,
  /en/properties/). "lang" lo fija cada uno de esos dos archivos antes
  de incluir esta plantilla. Los datos (propiedades, filtros
  disponibles, indexabilidad) son exactamente los mismos para ambos
  idiomas — nunca se duplica contenido estructurado, solo la interfaz.
#}
{% set lang = lang or "es" %}
{% set esEn = lang == "en" %}
{% set publicas = collections.propiedades | propiedadesPublicas %}
{% set filtrosDisp = publicas | filtrosDisponibles %}
{% set catalogoIndexable = collections.propiedades | catalogoEsIndexable %}
{% set urlAlternoEs = "https://makomgrp.com/propiedades/" %}
{% set urlAlternoEn = "https://makomgrp.com/en/properties/" %}
{% set urlCanonica = urlAlternoEn if esEn else urlAlternoEs %}
{% set langSwitchUrl = "/propiedades/" if esEn else "/en/properties/" %}
{% set descripcionSeo = "MAKOM CAPITAL GROUP — full-service real estate wealth management in Panama. Every property is reviewed before it is published." if esEn else "MAKOM CAPITAL GROUP — Gestora integral de patrimonio inmobiliario en Panamá. Cada propiedad fue evaluada antes de ser publicada." %}
{% set tituloSeo = "Properties | MAKOM CAPITAL GROUP" if esEn else "Propiedades | MAKOM CAPITAL GROUP" %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ descripcionSeo }}" />
  <meta name="theme-color" content="#0A0A0A" />
  <!-- Milestone 9: indexabilidad automática — indexable en cuanto
       exista al menos una propiedad real "disponible" publicada (sin
       seo.noIndex forzado); noindex mientras el inventario público sea
       exclusivamente contenido de prueba/desarrollo. Nadie necesita
       alternar esto a mano. -->
  <meta name="robots" content="{{ 'index, follow' if catalogoIndexable else 'noindex, nofollow' }}" />
  <link rel="canonical" href="{{ urlCanonica }}" />
  <link rel="alternate" hreflang="es" href="{{ urlAlternoEs }}" />
  <link rel="alternate" hreflang="en" href="{{ urlAlternoEn }}" />
  <link rel="alternate" hreflang="x-default" href="{{ urlAlternoEs }}" />
  <link rel="icon" type="image/svg+xml" href="/MAKOM_Logo_Files_v4.0/04_Favicon/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/MAKOM_Logo_Files_v4.0/04_Favicon/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/MAKOM_Logo_Files_v4.0/04_Favicon/favicon-16.png" />
  <link rel="apple-touch-icon" href="/MAKOM_Logo_Files_v4.0/04_Favicon/apple-touch-icon.png" />
  <title>{{ tituloSeo }}</title>
  <meta property="og:title" content="{{ tituloSeo }}" />
  <meta property="og:description" content="{{ descripcionSeo }}" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="{{ 'en_US' if esEn else 'es_PA' }}" />
  <meta property="og:url" content="{{ urlCanonica }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ tituloSeo }}" />
  <meta name="twitter:description" content="{{ descripcionSeo }}" />
  <link rel="stylesheet" href="/styles.css" />
  {% include "meta-pixel.njk" %}
</head>
<body class="pagina-interior">

{% include "header.njk" %}

<main id="main" role="main">
  <section class="propiedades" aria-labelledby="catalogo-heading">
    <div class="container propiedades__inner">
      <div class="propiedades__header">
        <span class="text-label">{{ "Available Properties" if esEn else "Propiedades Disponibles" }}</span>
        <h1 class="propiedades__heading" id="catalogo-heading" data-reveal>{{ "Curated properties. Not a catalog — a selection." if esEn else "Propiedades seleccionadas. No un catálogo — una curaduría." }}</h1>
        <p class="propiedades__subheadline" data-reveal>{{ "Every property at MAKOM is reviewed before it is published." if esEn else "Cada propiedad en MAKOM fue evaluada antes de ser publicada." }}</p>
      </div>

      {% if publicas.length > 0 %}
      {#
        Buscador del catálogo — motor único de filtrado (script.js,
        sección 6). Todo lo que ofrece la interfaz se deriva aquí, en el
        build, de datos PÚBLICOS: operacion, tipo, categoriaGeneral,
        zona, precio.monto y el catálogo de _data/propiedadesConfig.json.
        Nunca se lee ubicacionInterna. Una zona o un tipo solo aparece
        como opción si al menos una propiedad pública lo usa, así que al
        asignar "zona" desde el CMS y reconstruir, el selector la
        reconoce sin tocar código.
      #}
      {%- set zonasUsadas = [] -%}
      {%- set tiposUsados = [] -%}
      {%- for p in publicas -%}
        {%- if p.zona and zonasUsadas.indexOf(p.zona) == -1 -%}{%- set _z = zonasUsadas.push(p.zona) -%}{%- endif -%}
        {%- if p.tipo and tiposUsados.indexOf(p.tipo) == -1 -%}{%- set _t = tiposUsados.push(p.tipo) -%}{%- endif -%}
      {%- endfor -%}
      {#
        Catálogo COMPLETO de ubicaciones válidas (regiones y zonas), con
        etiquetas del idioma de la página. A diferencia del selector, que
        solo lista zonas con propiedades, esto permite al motor aceptar
        una zona válida aunque hoy no tenga inventario (cero resultados)
        y distinguirla de un identificador inexistente (se ignora).
      #}
      {%- set ubicacionesCatalogo = [] -%}
      {%- for r in propiedadesConfig.regiones -%}
        {%- set _ur = ubicacionesCatalogo.push({ t: "region", v: r.valor, l: ((r.etiquetaEn or r.etiqueta) if esEn else r.etiqueta) }) -%}
      {%- endfor -%}
      {%- for z in propiedadesConfig.zonas -%}
        {%- set _uz = ubicacionesCatalogo.push({ t: "zona", v: z.valor, r: z.region, l: ((z.etiquetaEn or z.etiqueta) if esEn else z.etiqueta) }) -%}
      {%- endfor -%}
      {#
        Catálogo COMPLETO de tipos de propiedad (etiquetas del idioma de
        la página): igual que con las zonas, un tipo válido sin
        propiedades es un filtro legítimo con cero resultados.
      #}
      {%- set tiposCatalogo = [] -%}
      {%- for t in propiedadesConfig.tipos -%}
        {%- set _ut = tiposCatalogo.push({ v: t.valor, l: ((t.etiquetaEn or t.etiqueta) if esEn else t.etiqueta) }) -%}
      {%- endfor -%}
      {#
        Presupuesto máximo: UNA sola lista, siempre habilitada y válida
        en cualquier pestaña (se compara con data-precio sin mirar la
        operación). Va en data-presupuestos y la lee el motor de
        script.js (sección 6).
        presupuestosVenta / presupuestosAlquiler NO los usa el catálogo:
        son el contrato con el buscador del Home (script.js, sección 19,
        los lee de este marcado). Se mantienen tal cual para que el Home
        se comporte exactamente igual.
      #}
      {%- set presupuestosCatalogo = "1500,2000,15000,100000,125000,150000,175000,200000,250000,300000,400000" -%}
      {%- set presupuestosVenta = "100000,150000,200000,300000" -%}
      {%- set presupuestosAlquiler = "1500,3000,7500" -%}
      <div class="prop-controles">
      {#
        Dos grupos independientes de selección única (role="radiogroup"):
        Operación (Todos / Venta / Alquiler) y Categoría (Todas /
        Residencial / Comercial). Se combinan con AND en script.js
        (sección 6). El grupo Operación conserva .filter-tab y
        data-filter="venta|alquiler": el buscador del Home lee esas
        pestañas de este marcado para saber qué operaciones ofrecer.
        La categoría usa data-categoria. Solo existe una opción además
        de "Todos"/"Todas" si hay inventario que la respalde.
      #}
      <div class="prop-filters">
        {% if filtrosDisp.venta or filtrosDisp.alquiler %}
        <div class="prop-filters__grupo" role="radiogroup" aria-label="{{ 'Transaction' if esEn else 'Operación' }}">
          <button type="button" class="filter-tab filter-tab--active" role="radio" aria-checked="true" tabindex="0" data-filter="all">{{ "All" if esEn else "Todos" }}</button>
          {% if filtrosDisp.venta %}<button type="button" class="filter-tab" role="radio" aria-checked="false" tabindex="-1" data-filter="venta">{{ "For Sale" if esEn else "Venta" }}</button>{% endif %}
          {% if filtrosDisp.alquiler %}<button type="button" class="filter-tab" role="radio" aria-checked="false" tabindex="-1" data-filter="alquiler">{{ "For Rent" if esEn else "Alquiler" }}</button>{% endif %}
        </div>
        {% endif %}
        {% if filtrosDisp.residencial or filtrosDisp.comercial %}
        <div class="prop-filters__grupo" role="radiogroup" aria-label="{{ 'Category' if esEn else 'Categoría' }}">
          <button type="button" class="filter-tab filter-tab--active" role="radio" aria-checked="true" tabindex="0" data-categoria="all">{{ "All" if esEn else "Todas" }}</button>
          {% if filtrosDisp.residencial %}<button type="button" class="filter-tab" role="radio" aria-checked="false" tabindex="-1" data-categoria="residencial">{{ "Residential" if esEn else "Residencial" }}</button>{% endif %}
          {% if filtrosDisp.comercial %}<button type="button" class="filter-tab" role="radio" aria-checked="false" tabindex="-1" data-categoria="comercial">{{ "Commercial" if esEn else "Comercial" }}</button>{% endif %}
        </div>
        {% endif %}
      </div>

      <form class="prop-buscador" id="prop-buscador" role="search" aria-label="{{ 'Refine your search' if esEn else 'Afinar la búsqueda' }}" novalidate data-ubicaciones="{{ ubicacionesCatalogo | dump }}" data-tipos="{{ tiposCatalogo | dump }}" hidden>
        <div class="prop-buscador__campos">
          <div class="prop-buscador__campo">
            <label class="prop-buscador__label" for="f-tipo">{{ "Property type" if esEn else "Tipo de propiedad" }}</label>
            <select class="prop-buscador__select" id="f-tipo">
              <option value="">{{ "All types" if esEn else "Todos los tipos" }}</option>
              {%- for t in propiedadesConfig.tipos %}
              {%- if tiposUsados.indexOf(t.valor) != -1 %}
              {%- set catsTipo = [] %}
              {%- for p in publicas %}{% if p.tipo == t.valor and catsTipo.indexOf(p.categoriaGeneral) == -1 %}{% set _c = catsTipo.push(p.categoriaGeneral) %}{% endif %}{% endfor %}
              <option value="{{ t.valor }}" data-cats="{{ catsTipo | join(' ') }}">{{ (t.etiquetaEn or t.etiqueta) if esEn else t.etiqueta }}</option>
              {%- endif %}
              {%- endfor %}
            </select>
          </div>
          <div class="prop-buscador__campo">
            <label class="prop-buscador__label" for="f-ubicacion">{{ "Location" if esEn else "Ubicación" }}</label>
            <select class="prop-buscador__select" id="f-ubicacion">
              <option value="">{{ "All locations" if esEn else "Todas las ubicaciones" }}</option>
              {%- for r in propiedadesConfig.regiones %}
              {%- set zonasRegion = [] %}
              {%- for z in propiedadesConfig.zonas %}{% if z.region == r.valor and zonasUsadas.indexOf(z.valor) != -1 %}{% set _x = zonasRegion.push(z) %}{% endif %}{% endfor %}
              {%- if zonasRegion.length > 0 %}
              {%- set etiquetaRegion = (r.etiquetaEn or r.etiqueta) if esEn else r.etiqueta %}
              <optgroup label="{{ etiquetaRegion }}">
                <option value="region:{{ r.valor }}">{{ etiquetaRegion }} — {{ "all areas" if esEn else "todas las zonas" }}</option>
                {%- for z in zonasRegion %}
                <option value="zona:{{ z.valor }}" data-region="{{ r.valor }}">{{ (z.etiquetaEn or z.etiqueta) if esEn else z.etiqueta }}</option>
                {%- endfor %}
              </optgroup>
              {%- endif %}
              {%- endfor %}
            </select>
          </div>
          <div class="prop-buscador__campo">
            <label class="prop-buscador__label" for="f-max">{{ "Maximum budget" if esEn else "Presupuesto máximo" }}</label>
            <select class="prop-buscador__select" id="f-max" data-presupuestos="{{ presupuestosCatalogo }}" data-presupuestos-venta="{{ presupuestosVenta }}" data-presupuestos-alquiler="{{ presupuestosAlquiler }}">
              <option value="">{{ "No limit" if esEn else "Sin límite" }}</option>
            </select>
          </div>
        </div>
        <ul class="prop-chips" id="f-chips" aria-label="{{ 'Active filters' if esEn else 'Filtros activos' }}" hidden></ul>
        <div class="prop-buscador__meta">
          <p class="prop-buscador__contador" id="f-contador" role="status" aria-live="polite"></p>
          <button type="button" class="prop-buscador__limpiar" id="f-limpiar" hidden>{{ "Clear filters" if esEn else "Limpiar filtros" }}</button>
        </div>
      </form>
      {#
        Script en línea, sin dependencias: se ejecuta mientras el HTML se
        analiza, antes del primer pintado, y adelanta lo que no puede
        esperar a script.js (que carga diferido). (1) Muestra el buscador
        (sin JavaScript permanece oculto, igual que antes). (2) Marca la
        opción de cada grupo (?op= / ?cat=) para que "Todos"/"Todas" no se vean
        activo un instante. (3) Si la URL trae algún parámetro del
        filtro, pone en <html> el estado de espera: la rejilla se oculta
        sin quitarle su espacio (no se ven las 23 tarjetas ni se mueve el
        contenido) y se reserva la fila de chips. NO filtra nada: solo
        comprueba si existen los nombres de parámetro; el motor de
        script.js sigue siendo la única fuente de verdad y es quien
        libera ese estado al pintar. Si script.js no llega a ejecutarse
        (red, error), el evento load —que ocurre después de que el
        script diferido terminó o falló— lo libera aquí y el catálogo
        completo queda visible. Sin JavaScript este bloque no corre y no
        se oculta nada.
      #}
      <script>
        (function () {
          try {
            var f = document.getElementById('prop-buscador');
            if (f) f.hidden = false;
            var h = document.documentElement;
            if (/[?&](op|cat|tipo|region|zona|max)=/.test(location.search)) {
              h.classList.add('catalogo-filtrando');
              if (/[?&](tipo|region|zona|max)=/.test(location.search)) h.classList.add('catalogo-con-chips');
              window.addEventListener('load', function () {
                h.classList.remove('catalogo-filtrando', 'catalogo-con-chips');
              });
            }
            var p = new URLSearchParams(location.search);
            var o = p.get('op');
            var c = p.get('cat');
            // Un grupo por dimensión: marca la opción de la URL en cada uno
            // (si el valor no existe, queda "Todos"/"Todas" como en el HTML).
            [['data-filter', (o === 'venta' || o === 'alquiler') ? o : null],
             ['data-categoria', (c === 'comercial' || c === 'residencial') ? c : null]].forEach(function (g) {
              var t = g[1] && document.querySelector('.filter-tab[' + g[0] + '="' + g[1] + '"]');
              if (!t) return;
              var grupo = t.parentNode.querySelectorAll('.filter-tab');
              for (var i = 0; i < grupo.length; i++) {
                grupo[i].classList.remove('filter-tab--active');
                grupo[i].setAttribute('aria-checked', 'false');
                grupo[i].tabIndex = -1;
              }
              t.classList.add('filter-tab--active');
              t.setAttribute('aria-checked', 'true');
              t.tabIndex = 0;
            });
          } catch (e) {}
        })();
      </script>
      </div>

      <div class="propiedades__grid" role="list" aria-label="{{ 'Property listings' if esEn else 'Listado de propiedades' }}">
        {% for p in publicas %}
        {% set portada = p.fotografias.galeria | portadaDe %}
        {% set specs = p.detallesCuantitativos | specsTexto(lang) %}
        {% set tituloP = (p.tituloEn or p.titulo) if esEn else p.titulo %}
        {% set ubicacionP = (p.ubicacionPublicaEn or p.ubicacionPublica) if esEn else p.ubicacionPublica %}
        <article class="property-card" data-op="{{ p.operacion }}" data-cat="{{ p.categoriaGeneral }}" data-tipo="{{ p.tipo }}"{% if p.zona %} data-zona="{{ p.zona }}"{% endif %}{% if p.precio and p.precio.monto %} data-precio="{{ p.precio.monto }}"{% endif %} role="listitem" aria-labelledby="cat-{{ p.slug }}-name">
          <div class="property-card__image">
            {% if portada %}
              <img src="{{ portada.archivo }}" alt="{{ portada.alt or tituloP }}" loading="lazy" />
            {% else %}
              <div class="property-card__image-vacia">
                <span class="property-card__image-vacia-texto">{{ "Photo coming soon" if esEn else "Foto próximamente" }}</span>
              </div>
            {% endif %}
            <div class="property-card__badges">
              <span class="property-card__type">{{ (p.operacion | etiquetaEn(propiedadesConfig.operaciones)) if esEn else (p.operacion | etiqueta(propiedadesConfig.operaciones)) }}</span>
              <span class="property-card__category">{{ (p.categoriaGeneral | etiquetaEn(propiedadesConfig.categoriasGenerales)) if esEn else (p.categoriaGeneral | capitalize) }}</span>
              {% if p.fechaEntrega %}<span class="property-card__category">{{ (p.fechaEntrega | etiquetaEn(propiedadesConfig.fechasEntrega)) if esEn else (p.fechaEntrega | etiqueta(propiedadesConfig.fechasEntrega)) }}</span>{% endif %}
              {% if p.estado == "reservada" %}<span class="ficha-propiedad__estado-tag">{{ "Reserved" if esEn else "Reservada" }}</span>{% endif %}
            </div>
          </div>
          <div class="property-card__body">
            <h2 class="property-card__name" id="cat-{{ p.slug }}-name">{{ tituloP }}</h2>
            <p class="property-card__location">{{ ubicacionP }}</p>
            <p class="property-card__price">{{ p.precio | precioFormato(p.operacion, lang) }}</p>
            {% if specs %}<p class="property-card__specs">{{ specs }}</p>{% endif %}
            <p class="property-card__ref">Ref. {{ p.referenciaMakom }}</p>
            <a href="{{ ('/en/properties/' if esEn else '/propiedades/') + p.slug + '/' }}" class="link--arrow property-card__cta">{{ "View property" if esEn else "Ver propiedad" }}</a>
          </div>
        </article>
        {% endfor %}
      </div>

      <div class="catalogo-sin-resultados" id="f-sin-resultados" hidden>
        <p class="catalogo-sin-resultados__texto">{{ "No properties match these filters. Try widening your search or clearing the filters." if esEn else "Ninguna propiedad coincide con estos filtros. Pruebe ampliar la búsqueda o limpiar los filtros." }}</p>
        <button type="button" class="btn btn--outline" id="f-sin-resultados-limpiar">{{ "Clear filters" if esEn else "Limpiar filtros" }}</button>
      </div>
      {% else %}
      <div class="catalogo-vacio" data-reveal>
        <p class="catalogo-vacio__texto">{{ "There are no public properties available right now. Check back soon or contact us directly." if esEn else "En este momento no hay propiedades públicas disponibles. Vuelva pronto o contáctenos directamente." }}</p>
      </div>
      {% endif %}

    </div>
  </section>
</main>

{% include "footer.njk" %}

</body>
</html>
